{
  "cleanUrls": false,
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "max-age=0, s-maxage=60, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "max-age=0, s-maxage=60, must-revalidate"
        }
      ]
    }
  ]
}
