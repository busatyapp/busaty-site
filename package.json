{
  "name": "busaty-site",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "node scripts/optimize-images.js && cross-env NODE_ENV=production vite build && node scripts/postbuild.js && node scripts/sitemap.js",
    "build:win": ".\\node-v20.11.1-win-x64\\node.exe scripts/optimize-images.js && set \"NODE_ENV=production\" && .\\node-v20.11.1-win-x64\\node.exe ./node_modules/vite/bin/vite.js build && .\\node-v20.11.1-win-x64\\node.exe scripts/postbuild.js && .\\node-v20.11.1-win-x64\\node.exe scripts/sitemap.js",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "npm run build && npx playwright test",
    "optimize:images": "node scripts/optimize-images.js",
    "validate:content": "node scripts/validate-content.js",
    "lint:perf": "lhci autorun --config=.lighthouserc.json"
  },
  "devDependencies": {
    "@lhci/cli": "^0.14.0",
    "@playwright/test": "^1.56.1",
    "@testing-library/dom": "^9.3.4",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "cross-env": "^10.1.0",
    "fast-glob": "^3.3.3",
    "jsdom": "^24.1.0",
    "sharp": "^0.34.5",
    "vite": "^5.4.0",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
