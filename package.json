{
  "name": "busaty-site",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "node ./node_modules/vite/bin/vite.js build && node scripts/postbuild.js && node scripts/sitemap.js",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "npm run build && npx playwright test",
    "validate:content": "node scripts/validate-content.js",
    "lint:perf": "lhci autorun --config=.lighthouserc.json"
  },
  "devDependencies": {
    "@lhci/cli": "^0.14.0",
    "@playwright/test": "^1.56.1",
    "@testing-library/dom": "^9.3.4",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "jsdom": "^24.1.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
